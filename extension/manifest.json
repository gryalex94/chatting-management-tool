{
  "manifest_version": 3,
  "name": "Chatting Manager for Fansly",
  "description": "Records the Fansly chats a chatter works in, shows the fan's notes, numbers and scripts beside the chat. Never sends anything to Fansly.",
  "version": "0.7.11",
  "permissions": [
    "alarms",
    "clipboardWrite",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://fansly.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chatting Manager"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fansly.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://fansly.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://fansly.com/*"
      ],
      "js": [
        "panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
